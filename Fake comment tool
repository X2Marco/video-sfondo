<!-- === GENERATORE COMMENTO MULTI-PIATTAFORMA — HOSTINGER VERSION === -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<div class="wrap" id="cmt-gen" style="margin:0 auto;color:#fff;font-family:Inter,system-ui,Segoe UI,Roboto,Arial;background:#000">

  <style>
    #cmt-gen{
      --white:#ffffff;
      --text:#0f172a;
      --muted-2:#6b7280;
      --card-shadow:0 14px 36px rgba(0,0,0,.22);
      --radius:28px;
      --stage-w:986px;
      --stage-h:272px;

      /* --- palette UI (dark elegante) --- */
      --bg:#000000;
      --panel:#0c0c0e;
      --panel-2:#121215;
      --line:rgba(255,255,255,.08);
      --line-soft:rgba(255,255,255,.05);
      --ink:#f5f5f7;
      --ink-dim:#9a9aa3;
      --accent:#7c5cff;
      --accent-2:#a78bfa;
      --accent-soft:rgba(124,92,255,.15);
      --focus:0 0 0 3px rgba(124,92,255,.35);
    }
    #cmt-gen *{box-sizing:border-box}
    #cmt-gen .shell{
      max-width:1180px;margin:0 auto;padding:28px 20px 44px;
    }
    #cmt-gen .header{
      display:flex;align-items:center;gap:12px;margin-bottom:22px;
    }
    #cmt-gen .header .dot{
      width:10px;height:10px;border-radius:50%;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      box-shadow:0 0 14px var(--accent-soft);
    }
    #cmt-gen .header h1{
      font-size:18px;font-weight:800;letter-spacing:.2px;margin:0;color:var(--ink);
    }
    #cmt-gen .header p{
      margin:2px 0 0;font-size:13px;color:var(--ink-dim);
    }

    #cmt-gen .layout{
      display:grid;
      grid-template-columns: minmax(300px,420px) 1fr;
      gap:20px;
      align-items:start;
    }
    @media (max-width: 880px){
      #cmt-gen .layout{grid-template-columns:1fr}
    }

    /* ---------- PANNELLO CONTROLLI ---------- */
    #cmt-gen .panel{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:20px;
      padding:18px;
      box-shadow:0 1px 0 rgba(255,255,255,.03) inset, 0 18px 40px rgba(0,0,0,.45);
    }

    /* ---- selettore stile piattaforma ---- */
    #cmt-gen .platform-select{
      display:grid;grid-template-columns:repeat(4,1fr);gap:8px;
      margin-bottom:14px;
    }
    #cmt-gen .platform-btn{
      display:flex;flex-direction:column;align-items:center;gap:6px;
      padding:12px 6px 10px;border-radius:13px;cursor:pointer;
      border:1px solid var(--line);background:var(--panel-2);
      color:var(--ink-dim);transition:all .15s ease;
      font-size:11px;font-weight:700;
    }
    #cmt-gen .platform-btn .ic-wrap{
      width:30px;height:30px;border-radius:9px;
      display:flex;align-items:center;justify-content:center;
      background:rgba(255,255,255,.06);
    }
    #cmt-gen .platform-btn svg{width:16px;height:16px}
    #cmt-gen .platform-btn:hover{border-color:rgba(255,255,255,.22);color:var(--ink)}
    #cmt-gen .platform-btn.active{
      border-color:var(--accent);color:#fff;
      background:linear-gradient(180deg, rgba(124,92,255,.18), rgba(124,92,255,.06));
      box-shadow:0 0 0 1px rgba(124,92,255,.35) inset, 0 8px 18px rgba(124,92,255,.18);
    }
    #cmt-gen .platform-btn.active .ic-wrap{background:rgba(255,255,255,.14);color:#fff}
    #cmt-gen .platform-btn[data-p="standard"].active .ic-wrap{color:var(--accent-2)}
    #cmt-gen .platform-btn[data-p="youtube"].active .ic-wrap{color:#ff4d4d}
    #cmt-gen .platform-btn[data-p="instagram"].active .ic-wrap{color:#e1306c}
    #cmt-gen .platform-btn[data-p="tiktok"].active .ic-wrap{color:#69f0d1}

    #cmt-gen .group{
      border:1px solid var(--line-soft);
      background:var(--panel-2);
      border-radius:14px;
      padding:14px;
      margin-bottom:12px;
    }
    #cmt-gen .group-title{
      font-size:11px;text-transform:uppercase;letter-spacing:.08em;
      color:var(--ink-dim);font-weight:700;margin-bottom:10px;
      display:flex;align-items:center;gap:6px;
    }
    #cmt-gen .group-title svg{width:14px;height:14px;opacity:.7}

    #cmt-gen .field{margin-bottom:10px}
    #cmt-gen .field:last-child{margin-bottom:0}
    #cmt-gen label{
      font-size:12px;color:var(--ink-dim);margin-bottom:6px;display:block;font-weight:600;
    }
    #cmt-gen .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    #cmt-gen .grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

    #cmt-gen input[type=text],
    #cmt-gen input[type=number],
    #cmt-gen textarea{
      width:100%;padding:11px 12px;border-radius:11px;
      border:1px solid var(--line);
      background:#0a0a0c;
      color:var(--ink);font-size:14px;font-family:inherit;
      transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }
    #cmt-gen input::placeholder,#cmt-gen textarea::placeholder{color:#55555f}
    #cmt-gen input:hover,#cmt-gen textarea:hover{border-color:rgba(255,255,255,.16)}
    #cmt-gen input:focus,#cmt-gen textarea:focus{
      outline:none;border-color:var(--accent);box-shadow:var(--focus);background:#0d0d10;
    }
    #cmt-gen textarea{min-height:78px;resize:vertical;line-height:1.4}

    #cmt-gen .range-row{display:flex;align-items:center;gap:10px}
    #cmt-gen input[type=range]{
      -webkit-appearance:none;width:100%;height:4px;border-radius:4px;
      background:var(--line);outline:none;
    }
    #cmt-gen input[type=range]::-webkit-slider-thumb{
      -webkit-appearance:none;width:16px;height:16px;border-radius:50%;
      background:var(--accent);cursor:pointer;border:2px solid #fff;
      box-shadow:0 1px 4px rgba(0,0,0,.5);
    }
    #cmt-gen .range-val{
      min-width:54px;text-align:right;font-size:12px;color:var(--ink-dim);
      font-weight:700;font-variant-numeric:tabular-nums;
    }

    #cmt-gen .file-drop{
      display:flex;align-items:center;gap:10px;
      border:1px dashed var(--line);border-radius:11px;
      padding:10px 12px;background:#0a0a0c;cursor:pointer;
      transition:border-color .15s ease, background .15s ease;
      position:relative;
    }
    #cmt-gen .file-drop:hover{border-color:var(--accent-2);background:#0d0d10}
    #cmt-gen .file-drop input[type=file]{
      position:absolute;inset:0;opacity:0;cursor:pointer;
    }
    #cmt-gen .file-drop .ic{
      width:30px;height:30px;border-radius:8px;flex:0 0 30px;
      background:var(--accent-soft);display:flex;align-items:center;justify-content:center;color:var(--accent-2);
    }
    #cmt-gen .file-drop .file-text{font-size:13px;color:var(--ink-dim)}
    #cmt-gen .file-drop .file-text b{color:var(--ink);font-weight:700}
    #cmt-gen .file-drop .clear-avatar{
      margin-left:auto;font-size:12px;color:var(--ink-dim);
      background:transparent;border:1px solid var(--line);border-radius:8px;
      padding:5px 9px;cursor:pointer;position:relative;z-index:2;
    }
    #cmt-gen .file-drop .clear-avatar:hover{color:var(--ink);border-color:rgba(255,255,255,.25)}

    #cmt-gen .actions{display:flex;gap:10px;margin-top:14px}
    #cmt-gen .btn{
      flex:1;border:none;padding:12px 14px;border-radius:12px;font-weight:700;font-size:14px;
      cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
      transition:transform .12s ease, filter .12s ease, opacity .12s ease;
    }
    #cmt-gen .btn svg{width:16px;height:16px}
    #cmt-gen .btn:active{transform:scale(.97)}
    #cmt-gen .btn-primary{
      background:linear-gradient(135deg,var(--accent),#6a48f0);color:#fff;
      box-shadow:0 8px 20px rgba(124,92,255,.35);
    }
    #cmt-gen .btn-primary:hover{filter:brightness(1.08)}
    #cmt-gen .btn-ghost{
      background:transparent;color:var(--ink);border:1px solid var(--line);
    }
    #cmt-gen .btn-ghost:hover{border-color:rgba(255,255,255,.3);background:rgba(255,255,255,.04)}
    #cmt-gen .btn-download{
      width:100%;margin-top:10px;
      background:var(--ink);color:#0a0a0c;
    }
    #cmt-gen .btn-download:hover{filter:brightness(.94)}

    /* ---------- LATO PREVIEW ---------- */
    #cmt-gen .preview-col{position:sticky;top:20px}
    #cmt-gen .preview-panel{
      background:radial-gradient(circle at 30% 20%, #141417, #050506 70%);
      border:1px solid var(--line);
      border-radius:20px;
      padding:28px 20px 22px;
      display:flex;flex-direction:column;align-items:center;
      min-height:340px;
      justify-content:center;
      position:relative;
      overflow:hidden;
      transition:background .25s ease;
    }
    #cmt-gen .preview-panel.bg-light{
      background:radial-gradient(circle at 30% 20%, #2a2a2e, #0d0d0f 70%);
    }
    #cmt-gen .preview-badge{
      position:absolute;top:14px;left:16px;
      font-size:11px;text-transform:uppercase;letter-spacing:.08em;
      color:var(--ink-dim);font-weight:700;
      display:flex;align-items:center;gap:6px;
    }
    #cmt-gen .preview-badge .live-dot{
      width:7px;height:7px;border-radius:50%;background:#34d399;
      box-shadow:0 0 8px rgba(52,211,153,.7);
      animation:pulse 1.8s ease-in-out infinite;
    }
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

    #cmt-gen .size-tag{
      position:absolute;top:14px;right:16px;
      font-size:11px;color:var(--ink-dim);
      background:rgba(255,255,255,.05);border:1px solid var(--line);
      padding:4px 9px;border-radius:999px;font-weight:600;
      font-variant-numeric:tabular-nums;
    }

    #cmt-gen .stage{
      width:var(--stage-w);height:var(--stage-h);
      display:flex;justify-content:center;align-items:center;
      margin-inline:auto;position:relative;
      max-width:100%;
      transition:background .2s ease;
    }
    #cmt-gen .stage.bg-white{background:#ffffff}
    #cmt-gen .stage.bg-black{background:#000000}
    #cmt-gen .stage.bg-transparent{
      background:
        linear-gradient(45deg, rgba(255,255,255,.06) 25%, transparent 25%) -8px 0/16px 16px,
        linear-gradient(-45deg, rgba(255,255,255,.06) 25%, transparent 25%) -8px 0/16px 16px,
        linear-gradient(45deg, transparent 75%, rgba(255,255,255,.06) 75%) -8px 0/16px 16px,
        linear-gradient(-45deg, transparent 75%, rgba(255,255,255,.06) 75%) -8px 0/16px 16px,
        #1a1a1d;
    }
    /* riquadro bianco "aderente al contenuto" solo per la preview a schermo
       di stili senza card propria (YouTube/Instagram): simula il feed
       bianco dell'app senza riempire tutto lo spazio export fisso */
    #cmt-gen .stage.bg-transparent .content-wrap{
      background:#ffffff;border-radius:14px;
      padding:14px 18px;
      box-shadow:0 10px 30px rgba(0,0,0,.35);
      display:inline-flex;
    }
    #cmt-gen .stage.bg-transparent.exporting{background:transparent !important}
    #cmt-gen .stage.bg-transparent.exporting .content-wrap{
      background:transparent;box-shadow:none;padding:0;
    }

    #cmt-gen .stage-scale{
      max-width:100%;
      transform-origin:center center;
    }

    /* =======================================================
       STILE: STANDARD (card bianca, ombra — invariato)
    ======================================================= */
    #cmt-gen .card.style-standard{
      background:var(--white);color:var(--text);
      border-radius:var(--radius);
      box-shadow:var(--card-shadow);
      padding:16px 22px;
      display:flex;gap:14px;align-items:flex-start;
      max-width:100%;
    }
    #cmt-gen .card.style-standard .avatar{
      width:46px;height:46px;border-radius:50%;
      flex:0 0 46px;overflow:hidden;
      display:flex;align-items:center;justify-content:center;
      font-weight:900;
    }
    #cmt-gen .card.style-standard .avatar img{width:100%;height:100%;object-fit:cover}
    #cmt-gen .card.style-standard .avatar .initial{font-size:28px;line-height:1}
    #cmt-gen .card.style-standard .body{flex:1;min-width:0}
    #cmt-gen .card.style-standard .name{color:var(--muted-2);font-weight:800;letter-spacing:.2px}
    #cmt-gen .card.style-standard .text{
      margin-top:6px;line-height:1.35;font-size:18px;white-space:pre-wrap;
    }
    #cmt-gen .card.style-standard .meta{
      margin-top:10px;display:flex;align-items:center;justify-content:space-between;
      color:var(--muted-2);font-weight:600;
    }
    #cmt-gen .card.style-standard .meta-left{display:flex;align-items:center;gap:8px}
    #cmt-gen .card.style-standard .likes{display:inline-flex;align-items:center;gap:8px}
    #cmt-gen .card.style-standard .likes svg{width:22px;height:22px}

    /* =======================================================
       STILE: YOUTUBE
       avatar + nome/tempo sulla stessa riga, testo sotto,
       riga azioni: like (thumb-up) numero, dislike, Rispondi
    ======================================================= */
    #cmt-gen .card.style-youtube{
      font-family:Roboto,Arial,sans-serif;
      background:transparent;color:#0f0f0f;
      display:flex;gap:12px;align-items:flex-start;
      padding:8px 4px;max-width:100%;
    }
    #cmt-gen .card.style-youtube .avatar{
      width:40px;height:40px;border-radius:50%;flex:0 0 40px;overflow:hidden;
      display:flex;align-items:center;justify-content:center;font-weight:700;
    }
    #cmt-gen .card.style-youtube .avatar img{width:100%;height:100%;object-fit:cover}
    #cmt-gen .card.style-youtube .avatar .initial{font-size:18px;line-height:1;color:#fff}
    #cmt-gen .card.style-youtube .body{flex:1;min-width:0}
    #cmt-gen .card.style-youtube .top{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}
    #cmt-gen .card.style-youtube .name{font-size:13px;font-weight:500;color:#0f0f0f}
    #cmt-gen .card.style-youtube .when{font-size:12px;color:#606060;font-weight:400}
    #cmt-gen .card.style-youtube .text{
      margin-top:2px;font-size:14px;line-height:1.4;color:#0f0f0f;white-space:pre-wrap;
    }
    #cmt-gen .card.style-youtube .meta{
      margin-top:8px;display:flex;align-items:center;gap:16px;color:#606060;
    }
    #cmt-gen .card.style-youtube .yt-action{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500}
    #cmt-gen .card.style-youtube .yt-action svg{width:18px;height:18px;stroke:#606060}
    #cmt-gen .card.style-youtube .reply{font-size:12px;font-weight:700;letter-spacing:.3px;color:#606060;text-transform:uppercase}

    /* =======================================================
       STILE: INSTAGRAM
       nome in grassetto + testo inline sulla stessa riga,
       tempo/Rispondi/like-count sotto, cuore a destra in verticale
    ======================================================= */
    #cmt-gen .card.style-instagram{
      font-family:-apple-system,Helvetica,Arial,sans-serif;
      background:transparent;color:#262626;
      display:flex;gap:12px;align-items:flex-start;
      padding:6px 4px;max-width:100%;
    }
    #cmt-gen .card.style-instagram .avatar{
      width:32px;height:32px;border-radius:50%;flex:0 0 32px;overflow:hidden;
      display:flex;align-items:center;justify-content:center;font-weight:700;
    }
    #cmt-gen .card.style-instagram .avatar img{width:100%;height:100%;object-fit:cover}
    #cmt-gen .card.style-instagram .avatar .initial{font-size:14px;line-height:1;color:#fff}
    #cmt-gen .card.style-instagram .body{flex:1;min-width:0}
    #cmt-gen .card.style-instagram .text-line{font-size:14px;line-height:1.45;color:#262626}
    #cmt-gen .card.style-instagram .text-line .name{font-weight:600;margin-right:5px}
    #cmt-gen .card.style-instagram .text-line .ig-text{white-space:pre-wrap}
    #cmt-gen .card.style-instagram .meta{
      margin-top:6px;display:flex;align-items:center;gap:14px;color:#8e8e8e;font-size:12px;
    }
    #cmt-gen .card.style-instagram .reply{font-weight:600;color:#8e8e8e}
    #cmt-gen .card.style-instagram .ig-likecount{font-weight:600;color:#8e8e8e;font-size:12px;margin-top:4px}
    #cmt-gen .card.style-instagram .heart-col{
      flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:3px;
      padding-top:4px;
    }
    #cmt-gen .card.style-instagram .heart-col svg{width:13px;height:13px;stroke:#262626;fill:none}

    /* =======================================================
       STILE: TIKTOK (card bianca arrotondata su sfondo nero —
       stesso stile "Standard" ma è quello iconico TikTok)
    ======================================================= */
    #cmt-gen .card.style-tiktok{
      background:var(--white);color:#161823;
      border-radius:14px;
      padding:14px 18px;
      display:flex;gap:12px;align-items:flex-start;
      max-width:100%;
      box-shadow:0 8px 24px rgba(0,0,0,.18);
    }
    #cmt-gen .card.style-tiktok .avatar{
      width:42px;height:42px;border-radius:50%;flex:0 0 42px;overflow:hidden;
      display:flex;align-items:center;justify-content:center;font-weight:800;
    }
    #cmt-gen .card.style-tiktok .avatar img{width:100%;height:100%;object-fit:cover}
    #cmt-gen .card.style-tiktok .avatar .initial{font-size:22px;line-height:1;color:#fff}
    #cmt-gen .card.style-tiktok .body{flex:1;min-width:0}
    #cmt-gen .card.style-tiktok .name{font-size:13px;font-weight:600;color:#161823;opacity:.55}
    #cmt-gen .card.style-tiktok .text{margin-top:4px;font-size:15px;line-height:1.4;color:#161823;white-space:pre-wrap}
    #cmt-gen .card.style-tiktok .meta{margin-top:8px;display:flex;align-items:center;justify-content:space-between;color:#161823;opacity:.55;font-size:12px;font-weight:500}
    #cmt-gen .card.style-tiktok .meta-left{display:flex;align-items:center;gap:8px}
    #cmt-gen .card.style-tiktok .likes{display:inline-flex;flex-direction:column;align-items:center;gap:2px}
    #cmt-gen .card.style-tiktok .likes svg{width:18px;height:18px}
    #cmt-gen .card.style-tiktok .likes span{font-size:11px}

    #cmt-gen .toast{
      position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(12px);
      background:var(--ink);color:#0a0a0c;font-weight:700;font-size:13px;
      padding:10px 16px;border-radius:999px;box-shadow:0 10px 30px rgba(0,0,0,.4);
      opacity:0;pointer-events:none;transition:opacity .2s ease, transform .2s ease;
      z-index:9999;
    }
    #cmt-gen .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

    #cmt-gen [data-only]{display:none}
  </style>

  <div class="shell">

    <div class="header">
      <span class="dot"></span>
      <div>
        <h1>Generatore Commento Social</h1>
        <p>Scegli lo stile, personalizza e scarica l'immagine in PNG</p>
      </div>
    </div>

    <div class="layout">

      <!-- ============== COLONNA CONTROLLI ============== -->
      <div class="panel">

        <div class="platform-select" id="platformSelect">
          <div class="platform-btn active" data-p="standard">
            <div class="ic-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
            </div>
            Standard
          </div>
          <div class="platform-btn" data-p="youtube">
            <div class="ic-wrap">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z"/></svg>
            </div>
            YouTube
          </div>
          <div class="platform-btn" data-p="instagram">
            <div class="ic-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </div>
            Instagram
          </div>
          <div class="platform-btn" data-p="tiktok">
            <div class="ic-wrap">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82a4.27 4.27 0 0 1-2.55-4.07h-3.18v14.6a2.59 2.59 0 1 1-2.59-2.59c.17 0 .33.01.49.04v-3.18a5.76 5.76 0 0 0-.49-.02 5.78 5.78 0 1 0 5.78 5.78V9.4a7.46 7.46 0 0 0 4.36 1.39V7.6a4.27 4.27 0 0 1-1.82-1.78z"/></svg>
            </div>
            TikTok
          </div>
        </div>

        <div class="group">
          <div class="group-title">
