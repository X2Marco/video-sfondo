  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script>
  (function(){
    const root=document.getElementById('cmt-gen');
    const elName=root.querySelector('#name');
    const elDate=root.querySelector('#date');
    const elLikes=root.querySelector('#likes');
    const elDislikes=root.querySelector('#dislikes');
    const elText=root.querySelector('#text');
    const avatarInput=root.querySelector('#avatar');
    const stage=root.querySelector('#stage');
    const stageScale=root.querySelector('#stageScale');
    const widthPx=root.querySelector('#widthPx');
    const heightPx=root.querySelector('#heightPx');
    const widthVal=root.querySelector('#widthVal');
    const heightVal=root.querySelector('#heightVal');
    const sizeTag=root.querySelector('#sizeTag');
    const clearAvatarBtn=root.querySelector('#clearAvatar');
    const toast=root.querySelector('#toast');
    const previewPanel=root.querySelector('#previewPanel');
    const platformSelect=root.querySelector('#platformSelect');

    const PLATFORMS=['standard','youtube','instagram','tiktok'];
    let currentPlatform='standard';
    let currentHue=Math.floor(Math.random()*360);
    let hasCustomAvatar=false;
    let avatarDataUrl=null;

    const DEFAULTS={
      name:'LAEMY', date:'8-2', likes:'15', dislikes:'0',
      text:'Ma scusa dopo che fai queste pokè\nle butti?',
      width:986, height:272
    };

    function initialsFrom(name){return (name||'U').replace('@','').split(' ').map(s=>s[0]||'').slice(0,2).join('').toUpperCase();}

    function setAvatarColorFromHue(circle,h){
      const bg=`hsl(${h} 80% 55%)`;
      const fg=`hsl(${h} 80% 28%)`;
      circle.style.background=bg;
      const span=circle.querySelector('.initial');
      if(span) span.style.color=fg;
    }
    function rerollAvatarColor(){currentHue=Math.floor(Math.random()*360);}

    function fitStage(){
      const availableW = previewPanel.clientWidth - 40;
      const w = parseInt(widthPx.value,10);
      const scale = Math.min(1, availableW / w);
      stageScale.style.transform = `scale(${scale})`;
      stage.style.height = (parseInt(heightPx.value,10) * scale) + 'px';
    }

    function applyAvatarToAll(){
      PLATFORMS.forEach(p=>{
        const circle=root.querySelector('#avatarCircle-'+p);
        if(!circle) return;
        if(hasCustomAvatar && avatarDataUrl){
          circle.innerHTML='<img src="'+avatarDataUrl+'" alt="avatar" />';
        }else{
          const nameRaw = root.querySelector('#name').value;
          circle.innerHTML=`<span class='initial'>${initialsFrom(nameRaw)}</span>`;
          setAvatarColorFromHue(circle, currentHue);
        }
      });
    }

    function update(){
      const name=elName.value.trim()||'Utente';
      const date=elDate.value.trim()||'';
      const likes=elLikes.value.trim()||'0';
      const dislikes=elDislikes.value.trim()||'0';
      const text=elText.value||'';

      // STANDARD
      root.querySelector('#outName-standard').textContent=name;
      root.querySelector('#outDate-standard').textContent=date;
      root.querySelector('#outLikes-standard').textContent=likes;
      root.querySelector('#outText-standard').innerText=text;

      // YOUTUBE (nome stile @handle minuscolo)
      const ytHandle = name.startsWith('@') ? name : '@'+name.toLowerCase().replace(/\s+/g,'');
      root.querySelector('#outName-youtube').textContent=ytHandle;
      root.querySelector('#outDate-youtube').textContent=date;
      root.querySelector('#outLikes-youtube').textContent=likes;
      root.querySelector('#outText-youtube').innerText=text;

      // INSTAGRAM (nome minuscolo senza spazi, come username)
      const igHandle = name.toLowerCase().replace(/\s+/g,'');
      root.querySelector('#outName-instagram').textContent=igHandle;
      root.querySelector('#outText-instagram').innerText=text;
      root.querySelector('#outDate-instagram').textContent=date;
      root.querySelector('#outLikes-instagram').textContent=likes;

      // TIKTOK
      root.querySelector('#outName-tiktok').textContent=name;
      root.querySelector('#outDate-tiktok').textContent=date;
      root.querySelector('#outLikes-tiktok').textContent=likes;
      root.querySelector('#outText-tiktok').innerText=text;

      applyAvatarToAll();

      const w=widthPx.value, h=heightPx.value;
      stage.style.setProperty('--stage-w',w+'px');
      stage.style.setProperty('--stage-h',h+'px');
      stage.setAttribute('data-size',`${w}×${h}`);
      widthVal.textContent=w+' px';
      heightVal.textContent=h+' px';
      sizeTag.textContent=`${w}×${h}`;

      fitStage();
    }

    function setPlatform(p){
      currentPlatform=p;
      PLATFORMS.forEach(name=>{
        const card=root.querySelector('#card-'+name);
        const wrap=root.querySelector('#wrap-'+name);
        const el = wrap || card; // youtube/instagram hanno un wrapper, standard/tiktok no
        if(el) el.style.display = (name===p) ? (wrap ? 'inline-flex' : 'flex') : 'none';
      });
      platformSelect.querySelectorAll('.platform-btn').forEach(btn=>{
        btn.classList.toggle('active', btn.dataset.p===p);
      });
      // sfondo dello stage: sempre scacchiera trasparente in anteprima
      // (le card mantengono il proprio sfondo bianco/colorato, lo stage
      // dietro serve solo a far capire visivamente cosa è trasparente)
      stage.classList.remove('bg-white','bg-black');
      stage.classList.add('bg-transparent');

      // mostra/nascondi campi specifici (es. dislike solo YouTube)
      root.querySelectorAll('[data-only]').forEach(el=>{
        el.style.display = (el.dataset.only===p) ? 'block' : 'none';
      });

      update();
    }

    platformSelect.querySelectorAll('.platform-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> setPlatform(btn.dataset.p));
    });

    [elName, elDate, elLikes, elDislikes, elText].forEach(inp=>{
      inp.addEventListener('input', update);
    });
    [widthPx, heightPx].forEach(inp=>{
      inp.addEventListener('input', update);
    });

    avatarInput.addEventListener('change', e=>{
      const f=e.target.files[0];
      if(!f){
        hasCustomAvatar=false; avatarDataUrl=null;
        update();
        return;
      }
      const r=new FileReader();
      r.onload=()=>{
        hasCustomAvatar=true;
        avatarDataUrl=r.result;
        update();
      };
      r.readAsDataURL(f);
    });

    clearAvatarBtn.addEventListener('click', (e)=>{
      e.preventDefault(); e.stopPropagation();
      avatarInput.value='';
      hasCustomAvatar=false; avatarDataUrl=null;
      update();
    });

    function randomInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
    function randomUsername(){
      const first=['laura','mario','sofia','nicolo','giulia','irene','tommi','andre','federico','chiara','kevin','mattia','samuele','giada','alex','leon','francy','bea','nico','vale'];
      const extra=['_','.', '', 'x','__','-'];
      const tail=['01','2000','98','_tv','real','official','_yt','pro','_design','_it','x'];
      const base=first[randomInt(0,first.length-1)];
      const sep=extra[randomInt(0,extra.length-1)];
      const maybeTail=Math.random()<0.7?tail[randomInt(0,tail.length-1)]:'';
      return (Math.random()<0.5?base:base.toUpperCase())+sep+maybeTail;
    }
    function randomDateLast30(){
      const now=new Date();const back=randomInt(0,30);
      const d=new Date(now.getTime()-back*24*60*60*1000);
      return `${d.getDate()}-${d.getMonth()+1}`;
    }
    function randomize(){
      elName.value=randomUsername();
      elDate.value=randomDateLast30();
      elLikes.value=String(randomInt(0,2000));
      elDislikes.value=String(randomInt(0,50));
      rerollAvatarColor();
      hasCustomAvatar=false; avatarDataUrl=null; avatarInput.value='';
      update();
    }
    root.querySelector('#randomize').addEventListener('click', randomize);

    root.querySelector('#resetBtn').addEventListener('click', ()=>{
      elName.value=DEFAULTS.name;
      elDate.value=DEFAULTS.date;
      elLikes.value=DEFAULTS.likes;
      elDislikes.value=DEFAULTS.dislikes;
      elText.value=DEFAULTS.text;
      widthPx.value=DEFAULTS.width;
      heightPx.value=DEFAULTS.height;
      avatarInput.value='';
      hasCustomAvatar=false; avatarDataUrl=null;
      update();
    });

    function showToast(msg){
      toast.textContent=msg;
      toast.classList.add('show');
      setTimeout(()=>toast.classList.remove('show'), 1800);
    }

    root.querySelector('#download').addEventListener('click', async ()=>{
      const prevTransform=stageScale.style.transform;
      const prevStageClasses = stage.className;
      stageScale.style.transform='none';
      stage.style.height = heightPx.value + 'px';
      // rimuovo qualsiasi sfondo dello stage solo per l'export
      // (incluso l'effetto scacchiera usato in anteprima),
      // così il PNG risulta realmente trasparente
      stage.classList.remove('bg-white','bg-black','bg-transparent');
      // per YouTube/Instagram, in export tolgo anche il riquadro bianco
      // "finto schermo" usato solo per la leggibilità in anteprima
      if(currentPlatform==='youtube' || currentPlatform==='instagram'){
        stage.classList.add('exporting');
      }
      try{
        const canvas=await html2canvas(stage,{backgroundColor:null,scale:2,useCORS:true});
        canvas.toBlob(blob=>{
          const a=document.createElement('a');
          a.href=URL.createObjectURL(blob);
          a.download='comment-'+currentPlatform+'.png';
          a.click();
          showToast('PNG scaricata ✓');
        });
      } finally {
        stage.className=prevStageClasses;
        stageScale.style.transform=prevTransform;
        fitStage();
      }
    });

    window.addEventListener('resize', fitStage);

    setPlatform('standard');
  })();
  </script>
